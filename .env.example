# Public — safe to expose to the browser. From https://www.strava.com/settings/api
VITE_STRAVA_CLIENT_ID=

# Secret — server-side only. Set this in your deployment platform's env vars
# (e.g. Vercel Project Settings -> Environment Variables), never commit it.
STRAVA_CLIENT_SECRET=

# Optional — used by Api/nutrition.js for branded food lookups. Get one free at
# https://api-ninjas.com. Without it, nutrition lookups fall back to Open Food Facts.
API_NINJAS_KEY=
